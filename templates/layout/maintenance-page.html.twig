{#
/**
 * @file
 * Theme implementation for a single Drupal page while offline.
 *
 * All available variables are mirrored in page.html.twig.
 * Some may be blank but they are provided for consistency.
 *
 * @see template_preprocess_maintenance_page()
 */
#}
{% extends 'guswds:site-container' %}

{% block site_content %}
  {% embed "guswds:usa-header" with {
    'is_extended': page.secondary.content is empty
  } %}
    {% block content %}
      {{ page.header }}
      {% embed 'guswds:usa-nav' with {
        'label': 'Primary navigation',
        'is_extended': page.secondary.content is empty
      } %}
        {% block content %}
          {{ page.navigation }}
          {{ page.secondary }}
        {% endblock %}
      {% endembed %}
    {% endblock %}
  {% endembed %}

  {% if page.breadcrumb %}
    {% include 'guswds:breadcrumb-wrapper' with {
      'has_constrain': false,
      'breadcrumb_content': page.breadcrumb,
    } %}
  {% endif %}

  {# We have to manually wrap region content. #}
  {% include '@guswds/layout/region.html.twig' with {
    'region': 'highlighted',
    'content': page.highlighted,
  } %}

  {# We have to manually wrap region content. #}
  {% include '@guswds/layout/region.html.twig' with {
    'region': 'help',
    'content': page.help,
  } %}

  <main id="main" class="main" role="main" tabindex="-1">
    {% if page.preface %}
      {% include 'guswds:region' with {
        'region_name': 'preface',
        'has_constrain': true,
        'region_content': page.preface,
      } %}
    {% endif %}

    {# page.content is missing page title. #}
    {% set content %}
      {{ page.title }}
      {{ page.status }}
      {{ page.content }}
    {% endset %}

    {% if content|trim is not empty %}
      {% include 'guswds:content' with {
        'has_constrain': true,
        'content_content': content,
      } %}
    {% endif %}

    {% if page.postscript %}
      {% include 'guswds:region' with {
        'region_name': 'postscript',
        'has_constrain': true,
        'region_content': page.postscript,
      } %}
    {% endif %}
  </main>

  {% embed 'guswds:usa-footer' with {
    has_back_to_top: true
  } %}
    {% block primary %}
      {{ page.footer }}
    {% endblock %}
    {% block secondary %}
      {{ page.subfooter }}
    {% endblock %}
  {% endembed %}

{% endblock %}
