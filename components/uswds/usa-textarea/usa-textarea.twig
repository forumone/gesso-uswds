{% set classes = [
  'usa-textarea',
  modifier_classes ? modifier_classes : '',
]|join(' ')|trim %}

{% set group_classes = [
  'usa-form-group',
  group_modifier_classes ? group_modifier_classes : '',
]|join(' ')|trim %}

{% set label_classes = [
  'usa-label',
  label_modifier_classes ? label_modifier_classes : '',
]|join(' ')|trim %}

<div class="{{ group_classes }}">
  <label class="{{ label_classes }}" for="{{ textarea_id }}">
    {{ textarea_label }}
    {% if not textarea_required %}<span class="usa-hint">({{ 'optional'|t }})</span>{% endif %}
  </label>
  {% if error_message %}
    <span class="usa-error-message" id="{{ textarea_id }}-message" role="alert">{{ error_message }}</span>
  {% endif %}
  {% apply spaceless %}
    <textarea class="{{ classes }}"
      id="{{ textarea_id }}"
      name="{{ textarea_id }}"
      {% if error_message %} aria-describedby="{{ textarea_id }}-message"{% endif %}
      {% if textarea_cols %} cols="{{ textarea_cols }}"{% endif %}
      {% if textarea_rows %} rows="{{ textarea_rows }}"{% endif %}
      {% if textarea_disabled %} disabled{% endif %}
      {% if textarea_required %} required{% endif %}></textarea>
  {% endapply %}
</div>
