{% set accordion = [] %}
{% for key, item in content.field_paragraphs|field_value %}
  {% if key|first != '#' %}
    {% set paragraph_id = item['#paragraph'].id.value %}
    {% set heading = drupal_field('field_title', 'paragraph', paragraph_id) %}
    {% set panel_content = drupal_field('field_wysiwyg', 'paragraph', paragraph_id) %}
    {% set accordion = accordion|merge([{ 'title': heading|field_value, 'content': panel_content|field_value }]) %}
  {% endif %}
{% endfor %}

{% include '@uswds/accordion/accordion.twig' with {
  'attributes': attributes,
  'modifier_classes': '',
  'accordion': accordion,
} %}

{{ content|cache_metadata }}
